<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>diegoschagas.Hypatia</PackageId>

	<Version>2.0.2</Version>
	<PackageVersion>2.0.2</PackageVersion>

    <Authors>DSC.Tech</Authors>
    <Company>DSC.Tech</Company>

    <PackageDescription>
      Lightweight, explicit CQRS messaging and dispatching infrastructure for .NET.
    </PackageDescription>

    <Description>
      Lightweight, explicit CQRS messaging and dispatching infrastructure for .NET.
    </Description>

    <PackageReadmeFile>
      README.md
    </PackageReadmeFile>

    <PackageProjectUrl>
      https://github.com/diegoschagas/DSC.Tech.Hypatia
    </PackageProjectUrl>

    <RepositoryUrl>
      https://github.com/diegoschagas/DSC.Tech.Hypatia
    </RepositoryUrl>

    <RepositoryType>Git</RepositoryType>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <PackageTags>
      messaging;cqrs;command;query;dispatcher;ddd;solid;clean-architecture;dotnet
    </PackageTags>

    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>